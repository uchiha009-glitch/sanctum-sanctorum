# Copy this file to .env and fill in your own values. Never commit .env.
# Get the token from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=<redacted>
# Get your own numeric Telegram user id from @userinfobot. This is the bot
# operator (admin: /admin, /ban, /unban). The owner is also just a user
# with their own private vault — the owner cannot read other users' vaults.
OWNER_ID=123456789
# Where files + the SQLite index live. Default is ./data next to bot.py.
SANCTUM_DATA_DIR=./data
# Optional: the OWNER's free Google Gemini key for /chat.
# Get one at https://aistudio.google.com (sign in with Google, "Get API key",
# create one, paste it here). This key is used ONLY for the owner's /chat —
# it is never spent on any other user. Other users link their OWN key inside
# Telegram with /setkey. Leave it empty and the owner gets the local
# in-character assistant instead of the AI; the vault works fully without it.
GEMINI_API_KEY=<redacted>
# Optional: server secret for encrypting users' linked Gemini keys at rest
# (see keystore.py). If unset, a random secret is generated once and kept
# in <data_dir>/key_secret. Set it if you manage secrets separately from
# the data directory (e.g. a fresh data directory would otherwise make
# previously linked keys unreadable until users re-link them).
SANCTUM_KEY_SECRET=<redacted>
